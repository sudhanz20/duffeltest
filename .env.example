# Duffel TEST access token (starts with duffel_test_). Get it in the Duffel dashboard:
# More > Developers > Access tokens. Never commit the real value.
DUFFEL_API_KEY=duffel_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Webhook secret. Duffel shows it ONCE, when the webhook is created.
# Leave blank if you will create the webhook from the playground page:
# the server then saves the secret here for you.
DUFFEL_WEBHOOK_SECRET=

# Local port for the playground.
PORT=3000
